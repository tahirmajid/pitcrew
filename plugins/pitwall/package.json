{
  "name": "pitwall",
  "version": "5.0.0",
  "description": "Pitwall: knowledge-base MCP server. A folder of notes as the source of truth, hybrid BM25 + vector + entity-graph search over a rebuildable index",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/index.js",
    "index": "node scripts/index.js",
    "index:rebuild": "node scripts/index.js --rebuild",
    "eval": "node scripts/eval.js",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "yaml": "^2.9.1",
    "zod": "^3.23.8"
  }
}
